# Cooking (audio processing) parallelism — passed through to cook.sh.
# COOK_PARALLEL: how many tracks to encode concurrently for zip downloads
#   (flac, oggflac, vorbis, aac, opus, mp3, wav*). Higher = faster single
#   downloads but more CPU/RAM under concurrent load. Default: 8.
# COOK_CPUS: CPU affinity range for taskset (e.g. "0-7" or "0-15"). Default: 0-7.
COOK_PARALLEL=8
COOK_CPUS=0-7
